---
- name: Install Python, pip and Chromium tools
  apt:
    name:
      - python3
      - python3-pip
      - chromium-browser
      - chromium-chromedriver
    state: present
    update_cache: yes

- name: Install Selenium and test libraries
  pip:
    name:
      - selenium
      - pytest
      - pytest-html
    executable: pip3
